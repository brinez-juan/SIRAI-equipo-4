# Copia este archivo como .env y llena los valores. El .env real NUNCA se sube a git.

# Conexión a MySQL: mysql://usuario:contraseña@host:puerto/base
DATABASE_URL=mysql://root:CAMBIAR@localhost:3306/sirai

# Llave para firmar los JWT. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
LLAVESECRETA=

# Llave AES-256 para cifrar teléfonos y notas (issue 07). 32 bytes en hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LLAVE_CIFRADO=
